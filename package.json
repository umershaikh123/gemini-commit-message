{
  "name": "color-theme-generator",
  "displayName": "AI Color Theme Generator",
  "publisher": "umershaikh123",
  "description": "Generate VS Code themes from color theory patterns.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umershaikh123/gemini-commit-message"
  },
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Themes"
  ],
  "activationEvents": [
    "onCommand:theme.generateFromColorTheory"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "theme.generateFromColorTheory",
        "title": "Generate Theme from Color Theory"
      }
    ],
    "themes": [
      {
        "label": "Generated AI Theme",
        "uiTheme": "vs-dark",
        "path": "./themes/current-generated-theme.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.1",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "webpack": "^5.103.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@types/color": "^3.0.6",
    "color": "^4.2.3"
  }
}
